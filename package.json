{
  "name": "stackwell-agency-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Stackwell - software agency platform (MERN)",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server --",
    "seed:admin": "npm run seed:admin -w server",
    "lint": "npm run lint -w client",
    "test": "npm test -w server && npm test -w client"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
