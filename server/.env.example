# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Origin of the React app (used later for CORS and email links)
CLIENT_URL=http://localhost:5173

# MongoDB connection string (Atlas: Connect -> Drivers). Contains a password - keep it secret.
# Include a database name before the "?", e.g. .../stackwell?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stackwell?retryWrites=true&w=majority

# Secret for signing JWT access tokens (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# A DIFFERENT secret for refresh tokens (generate it the same way)
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_REFRESH_EXPIRES_DAYS=7

# File storage: create a free account at cloudinary.com, then copy these three values from its dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Used only by `npm run seed:admin` to create the first admin. Remove the password afterwards.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
